# ──────────────────────────────────────────────────────────────
# 羽球賽事系統 — 環境變數範本
# 複製此檔案為 .env 並填入真實值
# ──────────────────────────────────────────────────────────────

# ── 資料庫連線（docker-compose 內網形式）────────────────────────
# docker-compose 部署時 hostname 固定為 "db"（docker 內網服務名稱）
# 本地開發可改為 172.16.69.68:5432（WSL IP）
DATABASE_URL=postgresql://app:CHANGE_ME@db:5432/badminton?schema=public

# ── PostgreSQL 容器環境變數 ──────────────────────────────────────
# docker-compose db service 使用這三個變數建立資料庫
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=badminton

# ── 後台管理密碼 ─────────────────────────────────────────────────
# 用於管理員登入，部署前必須更換
ADMIN_PASSWORD=CHANGE_ME

# ── Session 簽章金鑰 ──────────────────────────────────────────────
# 至少 32 個字元的隨機字串，可用 openssl rand -base64 32 產生
SESSION_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ── 應用程式端口 ─────────────────────────────────────────────────
# docker-compose 部署時 nginx 接管對外流量，此設定給 Next.js 內部使用
PORT=3000

# ── nginx 對外端口 ───────────────────────────────────────────────
# docker-compose 將測試機的這個 port 映射到 nginx:80
# 若 80 被其他服務佔用，改成 8080、8000 等任何未使用的 port
HTTP_PORT=8080

# ── 執行環境 ────────────────────────────────────────────────────
# 部署時設為 production；本地開發設為 development
NODE_ENV=production
